# PrepFlow 環境変数テンプレ（実値は .env にコピー＝コミット禁止）
# Codex: 実値はユーザーが用意。未設定でもビルドは通り、起動時に「未設定」を明示する設計にする。

# --- Supabase（バックエンド：Postgres/Auth/Storage） ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=eyJ...                 # クライアント公開可（RLS前提）
# SUPABASE_SERVICE_ROLE_KEY は端末/アプリには絶対に入れない（サーバ専用）

# --- オフライン同期（WS2で確定） ---
POWERSYNC_URL=                            # PowerSync採用時のエンドポイント
POWERSYNC_TOKEN_ENDPOINT=                 # Supabase Edge Function 等で発行

# --- 認証 ---
APPLE_SERVICES_ID=com.prepflow.app        # Sign in with Apple
APPLE_TEAM_ID=
MAGICLINK_REDIRECT_URL=prepflow://auth-callback

# --- 課金（P1・Webで完結＝IAP回避 A-5） ---
STRIPE_PUBLISHABLE_KEY=
STRIPE_CHECKOUT_URL=https://billing.prepflow.app

# --- 配布 ---
APP_BUNDLE_ID=com.prepflow.app
APP_STORE_CONNECT_TEAM_ID=
APP_STORE_CONNECT_ISSUER_ID=
APP_STORE_CONNECT_KEY_ID=
APP_STORE_CONNECT_API_KEY_PATH=           # AuthKey_XXXX.p8 のローカルパス。鍵本体はコミット禁止
